# ==============================================================================
# GODOL INSTITUTE OF BUSINESS — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=5000

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# Find these in your Supabase Dashboard: Project Settings -> API
# ------------------------------------------------------------------------------
# Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# Anon Public Key (safe for client-side / public requests)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (secret key with full administrative database privileges)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# NOTES:
# 1. If you leave these as placeholders, Godol seamlessly runs on the local DB.
# 2. As soon as you paste your actual Supabase URL & Service Key, the platform
#    will automatically connect to your live Supabase PostgreSQL database!
# 3. Run the SQL script in `supabase/schema.sql` in your Supabase SQL Editor.
# ------------------------------------------------------------------------------
