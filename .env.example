# ==============================================================================
# GODOL INSTITUTE OF BUSINESS — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=5000

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# Find these in your Supabase Dashboard: Project Settings -> API
# ------------------------------------------------------------------------------
# Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# Anon Public Key (safe for client-side / public requests)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (secret key with full administrative database privileges)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# BUNNY.NET STREAM & STORAGE CDN CONFIGURATION
# Find these in your Bunny.net Dashboard (Stream Library & Storage Zone)
# ------------------------------------------------------------------------------
# Bunny Stream Video Library ID (integer or UUID)
BUNNY_STREAM_LIBRARY_ID=your-bunny-stream-library-id
VITE_BUNNY_STREAM_LIBRARY_ID=your-bunny-stream-library-id

# Bunny Stream API Key (found in Video Library -> API Access)
BUNNY_STREAM_API_KEY=your-bunny-stream-api-key

# Bunny Storage Zone Name (for PDF slides, worksheets, course files)
BUNNY_STORAGE_ZONE_NAME=godol-course-materials

# Bunny Storage Zone Read/Write API Key
BUNNY_STORAGE_API_KEY=your-bunny-storage-api-key

# Bunny Pull Zone / CDN Hostname (e.g. godol-cdn.b-cdn.net)
BUNNY_CDN_HOSTNAME=godol-cdn.b-cdn.net
VITE_BUNNY_CDN_HOSTNAME=godol-cdn.b-cdn.net

# ------------------------------------------------------------------------------
# NOTES:
# 1. If you leave these as placeholders, Godol seamlessly runs on the local DB.
# 2. As soon as you paste your actual Supabase URL & Service Key, the platform
#    will automatically connect to your live Supabase PostgreSQL database!
# 3. Run the SQL script in `supabase/schema.sql` in your Supabase SQL Editor.
# ------------------------------------------------------------------------------
